# ============================================================
# Reverie — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# .env is gitignored — never commit real keys.

# --- DeepSeek (recommended for cost/performance) ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Google Gemini ---
GEMINI_API_KEY=your-key-here

# --- Grok (XAI) ---
XAI_API_KEY=your-key-here

# --- Kimi (Moonshot) ---
KIMI_API_KEY=sk-your-key-here

# --- GLM (Zhipu AI) ---
GLM_API_KEY=your-key-here

# --- Ollama (local) — no key needed ---
# OLLAMA_BASE_URL=http://localhost:11434

# --- Active provider ---
# Options: deepseek, openai, anthropic, gemini, grok, kimi, glm, ollama
REVERIE_LLM_PROVIDER=deepseek
# Model names: deepseek-v4-flash (default), deepseek-chat / deepseek-reasoner (legacy, deprecated 2026-07-24)
REVERIE_LLM_MODEL=deepseek-v4-flash
