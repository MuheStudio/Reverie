*.py[cod]
*.so
*.egg-info/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
dist/
build/
*.spec

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
