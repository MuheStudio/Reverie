# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
dist/
build/
*.spec

# Virtual environment
venv/
.venv/
env/
.tools/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
# Windows reserved device name collisions (e.g. `cmd > nul` junk files).
nul

# JavaScript package managers and build output
.pnpm-store/
node_modules/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/.vitest/
*.tsbuildinfo

# Generated macOS application and disk-image artifacts.
*.app/
*.dmg

# Project data (user-generated, local only). The whole directory is local;
# only keep placeholder files (.gitkeep) so empty directories survive clones.
data/*
data/**
!data/.gitkeep
!data/**/.gitkeep
data/config.invalid.*

# Environment secrets
.env
.env.*
!.env.example

# Pytest cache
.pytest_cache/
pytest-cache-files-*/

# Nuitka
*.build/
*.dist/

# Generated Windows installer staging
frontend/.installer-app/
frontend/.installer-resources/
frontend/.installer-source/
frontend/.runtime-cache/
frontend/.package-smoke/
frontend/.desktop-smoke/
frontend/.desktop-core-smoke/
frontend/.visual-check/
frontend/.macos-installer-app/
frontend/.macos-installer-resources/
frontend/.macos-runtime-dev/
frontend/.package-smoke-macos/
frontend/.dmg-smoke-macos/
frontend/release-macos/

# Ephemeral local resolver state; requirements-runtime.lock is authoritative.
uv.lock

# Vendored MIT renderer distribution is a source dependency, not build output.
!frontend/vendor/pixi-live2d-display/dist/
!frontend/vendor/pixi-live2d-display/dist/*.js
