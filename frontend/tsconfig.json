{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "node",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@gui/vibe-container": ["src/lib/vibeContainerMock.ts"],
      "@/components/DreamRoom": ["src/types/dream-room.d.ts"],
      "@/components/DreamRoom/index": ["src/types/dream-room.d.ts"]
    },
    "types": []
  },
  "include": [
    "src/index.tsx",
    "src/vite-env.d.ts",
    "src/types/global.d.ts",
    "src/types/optional-airi.d.ts",
    "src/types/dream-room.d.ts",
    "src/components/MvpRoom/**/*.tsx",
    "src/components/AvatarView/Live2DAdapter.tsx",
    "src/hooks/useMvpBridge.ts",
    "src/contracts/protocolV4.generated.ts",
    "src/lib/electronBridgeSocket.ts",
    "src/lib/llmModels.ts"
  ],
  "exclude": ["node_modules"]
}
