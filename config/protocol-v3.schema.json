{
  "$defs": {
    "CommandEnvelopeV3": {
      "$defs": {
        "PersonaScopeV3": {
          "additionalProperties": false,
          "properties": {
            "epoch": {
              "minimum": 1,
              "title": "Epoch",
              "type": "integer"
            },
            "fingerprint": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Fingerprint",
              "type": "string"
            },
            "persona_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Persona Id",
              "type": "string"
            }
          },
          "required": [
            "persona_id",
            "epoch",
            "fingerprint"
          ],
          "title": "PersonaScopeV3",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "command": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "created_at_utc": {
          "title": "Created At Utc",
          "type": "string"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "persona": {
          "$ref": "#/$defs/PersonaScopeV3"
        },
        "protocol_version": {
          "default": 3,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "command",
        "persona"
      ],
      "title": "CommandEnvelopeV3",
      "type": "object"
    },
    "CommandResultV3": {
      "$defs": {
        "DomainError": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "details": {
              "additionalProperties": true,
              "title": "Details",
              "type": "object"
            },
            "message": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Message",
              "type": "string"
            },
            "retryable": {
              "default": false,
              "title": "Retryable",
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "DomainError",
          "type": "object"
        },
        "ErrorCode": {
          "enum": [
            "INVALID_REQUEST",
            "STALE_PERSONA",
            "MODULE_UNAVAILABLE",
            "MODULE_DEGRADED",
            "CONSENT_REQUIRED",
            "LOCAL_MODE_BLOCKED",
            "PROVIDER_UNAVAILABLE",
            "PROVIDER_OUTCOME_UNKNOWN",
            "CONFLICT",
            "STORAGE_UNAVAILABLE",
            "INTERNAL"
          ],
          "title": "ErrorCode",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "protocol_version": {
          "default": 3,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "ok"
      ],
      "title": "CommandResultV3",
      "type": "object"
    },
    "DomainEventV3": {
      "$defs": {
        "PersonaScopeV3": {
          "additionalProperties": false,
          "properties": {
            "epoch": {
              "minimum": 1,
              "title": "Epoch",
              "type": "integer"
            },
            "fingerprint": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Fingerprint",
              "type": "string"
            },
            "persona_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Persona Id",
              "type": "string"
            }
          },
          "required": [
            "persona_id",
            "epoch",
            "fingerprint"
          ],
          "title": "PersonaScopeV3",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at_utc": {
          "title": "Occurred At Utc",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "payload_version": {
          "default": 1,
          "minimum": 1,
          "title": "Payload Version",
          "type": "integer"
        },
        "persona": {
          "$ref": "#/$defs/PersonaScopeV3"
        },
        "protocol_version": {
          "default": 3,
          "title": "Protocol Version",
          "type": "integer"
        }
      },
      "required": [
        "event_type",
        "persona"
      ],
      "title": "DomainEventV3",
      "type": "object"
    }
  },
  "$id": "https://reverie.local/schemas/protocol-v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reverie Protocol V3"
}
