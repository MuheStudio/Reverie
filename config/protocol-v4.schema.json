{
  "$defs": {
    "CommandEnvelopeV4": {
      "$defs": {
        "PersonaScopeV4": {
          "additionalProperties": false,
          "properties": {
            "epoch": {
              "minimum": 1,
              "title": "Epoch",
              "type": "integer"
            },
            "fingerprint": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Fingerprint",
              "type": "string"
            },
            "persona_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Persona Id",
              "type": "string"
            }
          },
          "required": [
            "persona_id",
            "epoch",
            "fingerprint"
          ],
          "title": "PersonaScopeV4",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "command": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "created_at_utc": {
          "title": "Created At Utc",
          "type": "string"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "persona": {
          "$ref": "#/$defs/PersonaScopeV4"
        },
        "protocol_version": {
          "default": 4,
          "title": "Protocol Version",
          "type": "integer"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "command",
        "persona"
      ],
      "title": "CommandEnvelopeV4",
      "type": "object"
    },
